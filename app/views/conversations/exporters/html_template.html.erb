<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #1f2d3d; max-width: 760px; margin: 32px auto; padding: 0 24px; line-height: 1.5; }
    h1 { font-size: 20px; margin: 0 0 4px 0; }
    .generated { font-size: 12px; color: #555; font-weight: 600; margin-bottom: 24px; }
    .message { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #eef0f3; }
    .message:last-child { border-bottom: none; }
    .sender { font-weight: 600; margin-bottom: 4px; }
    .content { margin: 0 0 8px 0; white-space: pre-wrap; word-wrap: break-word; }
    .attachments { font-size: 13px; color: #555; font-style: italic; margin: 4px 0; }
    .attachments a { color: #1f93ff; text-decoration: none; }
    .timestamp { font-size: 11px; color: #899096; }
  </style>
</head>
<body>
  <h1><%= title %></h1>
  <div class="generated"><%= generated_label %></div>

  <% rows.each do |row| %>
    <div class="message">
      <div class="sender"><%= row[:sender] %></div>
      <% if row[:content_html].present? %>
        <div class="content"><%= row[:content_html] %></div>
      <% end %>
      <% if row[:attachments].any? %>
        <div class="attachments">
          Adjuntos:
          <% row[:attachments].each_with_index do |attachment, idx| %>
            <a href="<%= attachment[:url] %>" target="_blank"><%= attachment[:name] %></a><%= ',' if idx < row[:attachments].size - 1 %>
          <% end %>
        </div>
      <% end %>
      <div class="timestamp"><%= row[:timestamp] %></div>
    </div>
  <% end %>
</body>
</html>
